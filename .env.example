APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# En production : APP_ENV=production et APP_DEBUG=false (SECURITY_RULES §14)
# Production : false obligatoire (OWASP A05)
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
# Production : true recommandé
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=strict
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# log = développement (aucun envoi réel). smtp = envoi réel.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.adsel.org
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Plateforme agroécologique"
MAIL_REPLY_TO_ADDRESS=
MAIL_REPLY_TO_NAME="Plateforme agroécologique"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sécurité (SECURITY_RULES.md)
SECURITY_FORM_MIN_SECONDS=2
# true en production : 2FA obligatoire pour super_admin / modérateur
SECURITY_REQUIRE_ADMIN_2FA=false

# Compte fondateur (invisible aux autres admins, seul gestionnaire des super_admin)
PLATFORM_OWNER_EMAIL=ismaelyveskabore@gmail.com

# Newsletter : envoi immédiat sans php artisan queue:work
NEWSLETTER_DISPATCH_SYNC=true
NEWSLETTER_SEND_MAILS_SYNC=true
NEWSLETTER_PROCESS_ON_ADMIN_VISIT=true
